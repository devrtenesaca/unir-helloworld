pipeline {
    agent any

    stages {
        stage('Get Code') {
            steps {
                echo 'Downloading the code'
                git branch: 'master', url: 'https://github.com/devrtenesaca/unir-helloworld.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Running Python code this is just an example'
                echo "Workspace directory is: ${WORKSPACE}"
                sh 'ls -l'
            }
        }
        stage ('Build and deploy container'){
            steps{
                echo ' build and deploy the container'
                sh '''
                   make build
                   make run
                '''
                 sh 'sleep 30' 
            }
        }
        
        
        stage (' Stage testing'){
            parallel {
               
                stage('Unit') {
                    steps {
                         catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE'){
                            sh '''
                                export PYTHONPATH=${WORKSPACE}
                                pytest --junitxml=result-unit.xml test/unit
                            '''
                         }
                    }
                }
                
                stage ('Service'){
                    steps {
                        sh '''
                            export PYTHONPATH=${WORKSPACE}
                            pytest --junitxml=result-rest.xml test/rest
                        '''
                    }
                }
                
            }
        }
                
        
        stage ('Results'){
            steps {
                junit 'result*.xml'
            }
        }
        
        
        stage ('clean'){
            steps {
                sh '''
                make stop
                make clean
                '''
            }
        }
    }
}