pipeline {
    agent any

    stages {
        stage('Get Code') {
            steps {
                echo 'Downloading the code'
                git branch: 'master', url: 'https://github.com/devrtenesaca/unir-helloworld.git'
            }
        }

 
        stage ('Building'){
            steps{
                echo 'Running Python code this is just an example'
                echo "Workspace directory is: ${WORKSPACE}"
                sh '''
                   make build
                   make run
                '''
                 sh 'sleep 30' 
            }
        }
        
        
        stage ('Testing'){
            parallel {
               
                stage('Unit') {
                    steps {
                         catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE'){
                            sh '''
                                export PYTHONPATH=${WORKSPACE}
                                pytest --junitxml=result-unit.xml test/unit
                            '''
                         }
                    }
                }
                
                stage ('Service'){
                    steps {
                        sh '''
                            export PYTHONPATH=${WORKSPACE}
                            pytest --junitxml=result-rest.xml test/rest
                        '''
                    }
                }
                
            }
        }
        
     stage('Coverage') {
                    steps {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            sh '''
                                coverage run --branch --source=app --omit=app/__init__.py,app/api.py -m pytest --junitxml=result-unit.xml test/unit
                                coverage xml
                            '''
                             //cobertura coberturaReportFile: 'coverage.xml', conditionalCoverageTargets: '100,0,80', lineCoverageTargets: '100,0,90'
                            recordCoverage(
                                    tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']],
                                    id: 'python-coverage',
                                    name: 'Python Coverage',
                                    qualityGates: [
                                        [threshold: 90.0, metric: 'LINE', baseline: 'PROJECT', unstable: true],
                                        [threshold: 80.0, metric: 'LINE', baseline: 'PROJECT', unstable: true]
                                    ]
                                )                              
                        }
                    }
        }    
                
        stage('Static') {
                    steps {
                        sh 'flake8 --exit-zero --format=pylint app > flake8.out'
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            recordIssues(
                                tools: [pyLint(name: 'Flake8-StaticReport', pattern: 'flake8.out')],
                                qualityGates: [
                                    [threshold: 8, type: 'TOTAL', unstable: true],
                                    [threshold: 10, type: 'TOTAL', unstable: false]
                                ]
                            )
                        }
                    }
                }
        
        
        stage('Security Test') {
            steps {
                sh '''
                    # Run bandit and save to bandit.out
                    # Using the template ensures it is compatible with the pylint parser
                    bandit --exit-zero -r . -f custom -o bandit.out --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                '''
                
                // We use 'pyLint' because 'bandit' is not recognized as a keyword in your Jenkins
                recordIssues(
                    tools: [pyLint(id: 'bandit', name: 'Bandit Security', pattern: 'bandit.out')],
                    qualityGates: [
                        [threshold: 1, type: 'TOTAL', unstable: true]
                    ]
                )
            }
        }
        
        
                
        stage('Performance Test') {
            steps {
                sh '''
                    # Run bandit and save to bandit.out
                    # Using the template ensures it is compatible with the pylint parser
                    jmeter -n -t test/jmeter/flask.jmx -f -l flask.jtl
                '''
               perfReport sourceDataFiles: 'flask.jtl' 
               
            }
        }
        
        
        stage ('Results'){
            steps {
                junit 'result*.xml'
            }
        }
        
        
        stage ('clean'){
            steps {
                sh '''
                make stop
                make clean
                '''
            }
        }
    }
}

