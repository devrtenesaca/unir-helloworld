{
    "name": "Python Flask + WireMock",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "vscjava.vscode-java-pack" 
            ]
        }
    },
    "forwardPorts": [5000, 9090],
    "postCreateCommand": "pip3 install -r requirements.txt"
}